{
    "name": "enicore/maris",
    "description": "A set of PHP utilities.",
    "autoload": {
        "psr-4": {
            "Enicore\\Maris\\": "src/"
        },
        "files": [
            "src/Functions/web.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "enshrined/svg-sanitize": "^1.0",
        "psr/container": "^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Enicore Solutions",
            "homepage": "https://enicore.com"
        }
    ]
}
